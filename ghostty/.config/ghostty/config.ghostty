# Readable defaults for Herdr and coding agents.
font-size = 14
theme = TokyoNight
window-padding-x = 8
window-padding-y = 8

# Hide the macOS titlebar and traffic-light buttons.
macos-titlebar-style = hidden

# Treat Option as Alt for terminal applications.
macos-option-as-alt = true

# Herdr shortcuts: send Ctrl+B (\x02) followed by a prefix command.
# Physical key codes keep these shortcuts independent of the input layout.
# Remove Ghostty's character bindings before adding the physical bindings.

# Tabs and panes.
keybind = cmd+t=unbind
keybind = cmd+KeyT=text:\x02c
keybind = cmd+w=unbind
keybind = cmd+KeyW=text:\x02x
keybind = cmd+shift+w=unbind
keybind = cmd+shift+KeyW=text:\x02X
keybind = cmd+d=unbind
keybind = cmd+KeyD=text:\x02v
keybind = cmd+shift+d=unbind
keybind = cmd+shift+KeyD=text:\x02-
keybind = cmd+shift+enter=text:\x02z

# Cycle panes: Tab / Shift+Tab after the prefix.
keybind = cmd+[=unbind
keybind = cmd+BracketLeft=text:\x02\x1b[Z
keybind = cmd+]=unbind
keybind = cmd+BracketRight=text:\x02\t

# Focus panes by direction; pane resizing remains prefix+r.
keybind = ctrl+alt+KeyH=text:\x02h
keybind = ctrl+alt+KeyJ=text:\x02j
keybind = ctrl+alt+KeyK=text:\x02k
keybind = ctrl+alt+KeyL=text:\x02l

# Workspaces: create, cycle with Ctrl+P / Ctrl+N, and search.
keybind = cmd+n=unbind
keybind = cmd+KeyN=text:\x02N
keybind = cmd+shift+[=unbind
keybind = cmd+shift+BracketLeft=text:\x02\x10
keybind = cmd+shift+]=unbind
keybind = cmd+shift+BracketRight=text:\x02\x0e
keybind = cmd+p=unbind
keybind = cmd+KeyP=text:\x02g

# Select Herdr tabs by number.
keybind = cmd+1=unbind
keybind = cmd+digit_1=text:\x021
keybind = cmd+2=unbind
keybind = cmd+digit_2=text:\x022
keybind = cmd+3=unbind
keybind = cmd+digit_3=text:\x023
keybind = cmd+4=unbind
keybind = cmd+digit_4=text:\x024
keybind = cmd+5=unbind
keybind = cmd+digit_5=text:\x025
keybind = cmd+6=unbind
keybind = cmd+digit_6=text:\x026
keybind = cmd+7=unbind
keybind = cmd+digit_7=text:\x027
keybind = cmd+8=unbind
keybind = cmd+digit_8=text:\x028
keybind = cmd+9=unbind
keybind = cmd+digit_9=text:\x029

# Select Herdr workspaces with Cmd+Option+1..9, keeping macOS screenshot keys free.
# CSI-u sends Herdr's prefix+Shift+digit command.
keybind = cmd+alt+digit_1=text:\x02\x1b[49;2u
keybind = cmd+alt+digit_2=text:\x02\x1b[50;2u
keybind = cmd+alt+digit_3=text:\x02\x1b[51;2u
keybind = cmd+alt+digit_4=text:\x02\x1b[52;2u
keybind = cmd+alt+digit_5=text:\x02\x1b[53;2u
keybind = cmd+alt+digit_6=text:\x02\x1b[54;2u
keybind = cmd+alt+digit_7=text:\x02\x1b[55;2u
keybind = cmd+alt+digit_8=text:\x02\x1b[56;2u
keybind = cmd+alt+digit_9=text:\x02\x1b[57;2u

# Avoid closing Ghostty's own tab instead of a Herdr tab.
keybind = cmd+alt+w=unbind
keybind = cmd+alt+KeyW=ignore
